# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never put real credentials in this file.

# Runtime environment: development | test | production
APP_ENV=development
APP_NAME=Hospital Management System
LOG_LEVEL=INFO

# Primary development database (REQUIRED).
# Driver must be psycopg 3: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://hms_app:change-me@localhost:5432/hms_dev

# Isolated test database (REQUIRED to run the integration test suite).
# Must be a different database whose name ends in `_test`; the test suite
# refuses to run otherwise, so tests can never touch development data.
TEST_DATABASE_URL=postgresql+psycopg://hms_app:change-me@localhost:5432/hms_test

# IANA time zone of the facility, used for calendar-date rules such as
# "date of birth cannot be in the future". Timestamps are always stored/returned in UTC.
APP_TIMEZONE=UTC

# Lifetime of a login token in minutes (5-1440). Tokens are random values; only their
# SHA-256 is stored, so there is no signing secret to configure.
AUTH_TOKEN_TTL_MINUTES=480
# Stage 6 session / login protection (defaults shown).
AUTH_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15

# The first administrator is created with:
#   python -m app.cli create-admin --username admin --employee-code ADM-0001
# which prompts for the password (or reads HMS_ADMIN_PASSWORD from the environment for
# automation). Never put an admin password in this file or in .env.

# --- AI assistant (Stage 7) ------------------------------------------------------------
# Provider: gemini | openrouter | fake (deterministic, offline - for tests/dev) | disabled
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Put the real key only in .env (git-ignored). Without it the assistant answers HTTP 503.
GEMINI_API_KEY=
# OpenRouter provider (LLM_PROVIDER=openrouter, e.g. LLM_MODEL=inclusionai/ling-3.0-flash-sante:free).
# Put the real key only in .env (git-ignored).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Output budget incl. the model's internal reasoning tokens (too low truncates the JSON answer).
LLM_MAX_OUTPUT_TOKENS=8192
# Model behaviour and evidence volume (defaults shown).
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
AI_MAX_ITEMS_PER_TOOL=50
# LangChain/LangSmith tracing would send patient data to a third party; keep this false.
AI_ALLOW_EXTERNAL_TRACING=false

# --- Stage 8: four-day potential risk analysis (the 4-day horizon itself is fixed in code) ---
# Signal rule set. "demo-v1" is an illustrative prototype and is NOT clinically validated.
AI_RISK_RULESET=demo-v1
# Evidence window before the reference time (hours, 24-168).
AI_RISK_EVIDENCE_LOOKBACK_HOURS=96
# Event triggers (comma-separated; empty = manual only). Supported: observation.created
AI_RISK_EVENT_TRIGGERS=
# Minimum minutes between two event-triggered analyses of the same patient.
AI_RISK_TRIGGER_COOLDOWN_MINUTES=30

# Seconds to wait when opening a database connection.
DB_CONNECT_TIMEOUT=5
